<Window x:Class="LightON_Final.ControlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LightON_Final.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:LightSettingsViewModel}"
        mc:Ignorable="d"
        Title="LightON" Height="420" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True">
    
    <Border CornerRadius="16" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="3" Color="#000"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F7FC" Offset="0"/>
                <GradientStop Color="#E3EEF7" Offset="0.5"/>
                <GradientStop Color="#D6E6F2" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <StackPanel Margin="20">
            <!-- Title Bar -->
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <CheckBox Grid.Column="0" IsChecked="{Binding IsOn}" 
                          VerticalAlignment="Center" Margin="0,0,8,0">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <TextBlock Grid.Column="1" Text="LightON" FontSize="18" FontWeight="SemiBold" 
                           Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Width="26" Height="26" 
                        Background="Transparent" BorderThickness="0" 
                        FontSize="14" Foreground="#7F8C8D" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="13">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            
            <!-- Brightness -->
            <TextBlock Text="Brightness" Foreground="#5D6D7E" FontSize="12" 
                       FontWeight="Medium" Margin="0,0,0,6"/>
            <Border Background="#FFFFFF" CornerRadius="10" Height="36" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <Slider Minimum="0.1" Maximum="1.0" Value="{Binding Intensity}" 
                        VerticalAlignment="Center" Margin="12,0" IsMoveToPointEnabled="True"/>
            </Border>
            
            <!-- Color Temperature -->
            <TextBlock Text="Color Temperature" Foreground="#5D6D7E" FontSize="12" 
                       FontWeight="Medium" Margin="0,0,0,6"/>
            <Border CornerRadius="10" Height="36" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FFB432" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ColorTemperature}" 
                        VerticalAlignment="Center" Margin="12,0" IsMoveToPointEnabled="True"/>
            </Border>
            
            <!-- Ring Size -->
            <TextBlock Text="Ring Size" Foreground="#5D6D7E" FontSize="12" 
                       FontWeight="Medium" Margin="0,0,0,6"/>
            <Border Background="#FFFFFF" CornerRadius="10" Height="36" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <Slider Minimum="0.3" Maximum="1.0" Value="{Binding RingSize}" 
                        VerticalAlignment="Center" Margin="12,0" IsMoveToPointEnabled="True"/>
            </Border>
            
            <!-- Ring Thickness -->
            <TextBlock Text="Ring Thickness" Foreground="#5D6D7E" FontSize="12" 
                       FontWeight="Medium" Margin="0,0,0,6"/>
            <Border Background="#FFFFFF" CornerRadius="10" Height="36" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <Slider Minimum="0.2" Maximum="1.0" Value="{Binding RingThickness}" 
                        VerticalAlignment="Center" Margin="12,0" IsMoveToPointEnabled="True"/>
            </Border>
            
            <!-- Exit Button -->
            <Button Content="Exit Application" Click="ExitButton_Click" 
                    Height="32" Background="#E74C3C" Foreground="White"
                    FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
